{
  "name": "@extractor-rfp/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.js",
    "./ready": "./src/vercelReady.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch-path=src --env-file=../../.env src/index.js",
    "start": "node --env-file=../../.env src/index.js",
    "seed": "node --env-file=../../.env src/seed/seedChecklist.js",
    "cleanup:uploads": "node --env-file=../../.env scripts/cleanup-uploads.js",
    "test": "node --test test/**/*.test.js",
    "build": "node -e \"console.log('api lista')\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@vercel/functions": "2.2.13",
    "cors": "^2.8.5",
    "exceljs": "4.4.0",
    "express": "^5.3.0",
    "mammoth": "^1.11.0",
    "mongodb": "^6.21.0",
    "multer": "^2.0.2",
    "pdf-lib": "1.17.1",
    "serverless-http": "3.2.0",
    "unpdf": "^2.1.0",
    "word-extractor": "1.0.4",
    "xls-reader": "0.7.0"
  }
}

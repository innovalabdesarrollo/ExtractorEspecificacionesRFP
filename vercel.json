{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"installCommand": "pnpm install",
	"buildCommand": "pnpm --filter @extractor-rfp/web build",
	"outputDirectory": "apps/web/.vercel/output",
	"rewrites": [
		{ "source": "/api/(.*)", "destination": "/api" },
		{ "source": "/uploads/(.*)", "destination": "/api" }
	],
	"functions": {
		"api/index.js": {
			"runtime": "nodejs22.x",
			"maxDuration": 300,
			"memory": 1024,
			"includeFiles": "{apps/api/**,node_modules/**}"
		}
	}
}

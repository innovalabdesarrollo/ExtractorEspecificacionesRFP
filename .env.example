# Local: Node ≥ 24.22.1 recomendado · Vercel: Node 22.x
# MongoDB Atlas — el nombre de DB va en la URI (/extractor_rfp_lintel)
MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/extractor_rfp_lintel?retryWrites=true&w=majority

# --- Solo local ---
PORT=3052
WEB_PORT=5192
CORS_ORIGIN=http://127.0.0.1:5192
PUBLIC_API_URL=http://127.0.0.1:3052

# --- Vercel (mismo origen web+api) ---
# PUBLIC_API_URL=          ← déjalo vacío o no lo definas (fetch a /api)
# CORS_ORIGIN=https://tu-app.vercel.app

# Anthropic Claude (análisis RFP)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Opcional: lotes RFP grandes
# EVAL_DOC_CHARS=90000
# EVAL_DOC_OVERLAP=2000
# EVAL_SPEC_BATCH=40

# Opcional: liberar análisis atascado (minutos)
# ANALYSIS_LOCK_STALE_MIN=45

# Opcional local: EMFILE
# CHOKIDAR_USEPOLLING=1

# Opcional: forzar guardar uploads en Mongo también en local
# PERSIST_UPLOADS_IN_MONGO=1
